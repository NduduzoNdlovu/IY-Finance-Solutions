+.service-legal-insurance .legal-plan-card { position: relative; display: flex; flex-direction: column; min-width: 0; padding: 30px 26px 26px; background: #fff; border: 1px solid #dce6e1; border-radius: 12px 28px 12px 28px; box-shadow: 0 14px 38px rgba(5,45,34,.07); transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
+.service-legal-insurance .legal-plan-card:hover { transform: translateY(-5px); border-color: #89c83b; box-shadow: 0 22px 48px rgba(5,45,34,.13); }
+.service-legal-insurance .legal-plan-card.is-featured { border: 2px solid var(--green-700); box-shadow: 0 20px 48px rgba(5,45,34,.13); }
+.service-legal-insurance .legal-plan-topline { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 27px; margin-bottom: 18px; }
+.service-legal-insurance .legal-plan-tier { color: var(--green-700); font-size: .72rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
+.service-legal-insurance .legal-plan-badge { padding: 6px 10px; color: var(--green-950); background: var(--lime-400); border-radius: 3px 12px 3px 12px; font-size: .68rem; font-weight: 850; white-space: nowrap; }
+.service-legal-insurance .legal-plan-card h3 { margin-bottom: 13px; color: var(--green-950); font-size: 1.55rem; }
+.service-legal-insurance .legal-plan-price { display: flex; align-items: baseline; gap: 5px; color: var(--green-700); }
+.service-legal-insurance .legal-plan-price strong { font-size: clamp(2.25rem, 3.2vw, 2.85rem); line-height: 1; letter-spacing: -.06em; }
+.service-legal-insurance .legal-plan-price span { color: var(--muted); font-size: .9rem; font-weight: 650; }
+.service-legal-insurance .legal-plan-member { margin: 8px 0 20px; font-size: .82rem; }
+.service-legal-insurance .legal-plan-family { display: grid; grid-template-columns: 22px 1fr; gap: 3px 9px; padding: 14px; background: var(--smoke-white); border-left: 3px solid var(--lime-500); border-radius: 3px 12px 3px 12px; color: var(--ink); font-size: .83rem; }
+.service-legal-insurance .legal-plan-family > i { grid-row: span 2; margin-top: 3px; color: var(--green-700); }
+.service-legal-insurance .legal-plan-family small { grid-column: 2; color: var(--muted); font-size: .74rem; }
+.service-legal-insurance .legal-plan-features { display: grid; gap: 12px; margin: 23px 0; padding: 0; list-style: none; }
+.service-legal-insurance .legal-plan-features li { display: grid; grid-template-columns: 17px 1fr; gap: 9px; color: #34463e; font-size: .88rem; line-height: 1.5; }
+.service-legal-insurance .legal-plan-features i { margin-top: 4px; color: var(--green-600); font-size: .78rem; }
+.service-legal-insurance .legal-plan-extras { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }
+.service-legal-insurance .legal-plan-extras p { display: grid; gap: 4px; margin: 0 0 12px; font-size: .78rem; }
+.service-legal-insurance .legal-plan-extras p span { color: var(--muted); }
+.service-legal-insurance .legal-plan-extras p strong { color: var(--green-950); font-size: .83rem; line-height: 1.4; }
+.service-legal-insurance .legal-plan-cta { width: 100%; margin-top: 12px; }
+.service-legal-insurance .legal-plan-footnote { max-width: 950px; margin: 22px auto 0; color: #66756e; font-size: .78rem; line-height: 1.6; }
