DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^index\.html$ index.php [R=301,L,NE]
    RewriteRule ^credit-assistance/?$ credit-assistance.php [L,QSA]
    RewriteRule ^feedback/?$ feedback.php [L,QSA]
    RewriteRule ^client-reviews/?$ client-reviews.php [L,QSA]
    RewriteRule ^admin/feedback/?$ admin/feedback.php [L,QSA]
    RewriteRule ^admin/credit-enquiries/?$ admin/credit-enquiries.php [L,QSA]
    RewriteRule ^r/(IYF-[0-9]{8}-[A-Fa-f0-9]{6})/?$ referral.php?ref=$1 [L,QSA,NC]
    RewriteRule ^(.+)\.html$ $1.php [R=301,L,NE]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    <FilesMatch "\.(?:css|js|jpg|jpeg|png|webp|gif|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<FilesMatch "^(?:\.user\.ini|\.htaccess|README\.md)$">
    Require all denied
</FilesMatch>
